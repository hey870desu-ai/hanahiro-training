rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 匿名認証済みユーザーのみ users コレクションに読み書き可能
    match /users/{userId} {
      allow read, write: if request.auth != null;
      match /progress/{moduleId} {
        allow read, write: if request.auth != null;
      }
    }
    // 管理画面用: collectionGroup('progress') クエリ許可
    match /{path=**}/progress/{moduleId} {
      allow read: if request.auth != null;
    }

    // 勤務形態一覧表（事業所ごと）— 匿名認証済みなら全事業所read/write可
    match /shift-schedules/{facilityId} {
      allow read, write: if request.auth != null;
    }
  }
}
